{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "public/voice-runtime/**",
    "public/content/**",
    "public/dictionaries/**",
    "public/assistant-runtime/**"
  ]
}
