# Public Firebase web-app configuration. Never put a service-account key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public production origin, e.g. https://your-domain.co.za (no trailing path).
# Enables canonical URLs, absolute social previews and sitemap entries.
NEXT_PUBLIC_SITE_URL=

# Optional Firebase passwordless email-link sign-in. Disabled until the Firebase
# Email/Password + Email Link provider and authorized domains are configured.
NEXT_PUBLIC_FIREBASE_EMAIL_LINK_ENABLED=false
