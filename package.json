{
  "name": "leesmaat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm art && node scripts/build-voice.mjs && node scripts/build-assistant.mjs && node scripts/prepare-build.mjs && next build && node scripts/build-sw.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:sync": "firebase emulators:exec --project demo-leesmaat --only firestore,auth \"tsx --test tests/security/*.test.ts\"",
    "art": "tsx scripts/create-brand.ts",
    "content:import": "python3 scripts/import-content.py",
    "voices:import": "python3 scripts/import-voice-assets.py",
    "dictionary:import": "python3 scripts/import-dictionary.py",
    "assistant:import": "node scripts/import-assistant.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^13.1.0",
    "next": "16.4.2",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
