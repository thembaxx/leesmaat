{
  "name": "leesmaat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm art && node scripts/prepare-build.mjs && next build && node scripts/build-sw.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:sync": "firebase emulators:exec --project demo-leesmaat --only firestore,auth \"tsx --test tests/security/*.test.ts\"",
    "art": "tsx scripts/create-brand.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.0.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "firebase-tools": "^15.33.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@11.25.0"
}
